{
  "name": "TenantReview",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "landlord_name": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "maxLength": 2000
    },
    "removed": {
      "type": "boolean",
      "default": false
    },
    "removed_by": {
      "type": "string"
    },
    "removed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "owner_user_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}