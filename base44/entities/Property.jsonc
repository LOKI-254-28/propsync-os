{
  "name": "Property",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "Apartment Complex",
        "Building",
        "Mixed Use",
        "Commercial",
        "Townhouse",
        "Villa"
      ],
      "default": "Apartment Complex"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Archived"
      ],
      "default": "Active"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Property-level amenities from the fixed catalog"
    },
    "expected_unit_count": {
      "type": "number",
      "default": 0,
      "description": "Informational expected number of units"
    },
    "notes": {
      "type": "string"
    },
    "monthly_operating_expenses": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "KES"
    },
    "latitude": {
      "type": "number",
      "description": "Map latitude for the property location"
    },
    "longitude": {
      "type": "number",
      "description": "Map longitude for the property location"
    },
    "owner_user_id": {
      "type": "string",
      "description": "The landowner who owns this property"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "data.status": "Active"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "landowner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    }
  }
}