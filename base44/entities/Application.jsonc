{
  "name": "Application",
  "type": "object",
  "properties": {
    "application_reference": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "applicant_name": {
      "type": "string"
    },
    "applicant_email": {
      "type": "string"
    },
    "applicant_phone": {
      "type": "string"
    },
    "id_number": {
      "type": "string"
    },
    "occupation": {
      "type": "string"
    },
    "monthly_income": {
      "type": "number"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "monthly_rent": {
      "type": "number"
    },
    "proposed_start_date": {
      "type": "string",
      "format": "date"
    },
    "message": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Submitted",
        "Under Review",
        "More Information Required",
        "Information Provided",
        "Site Visit Requested",
        "Site Visit Scheduled",
        "Site Visit Completed",
        "Agreement Issued",
        "Agreement Executed",
        "Payment Requested",
        "Payment Proof Submitted",
        "Payment Verified",
        "Approved",
        "Completed",
        "Rejected",
        "Withdrawn",
        "Cancelled",
        "Expired",
        "Pending"
      ],
      "default": "Submitted"
    },
    "reservation_expiry": {
      "type": "string",
      "format": "date"
    },
    "landlord_response": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date"
    },
    "application_type": {
      "type": "string",
      "enum": [
        "rental"
      ],
      "default": "rental"
    },
    "listing_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "booked_occupied": {
      "type": "boolean",
      "default": false,
      "description": "Booked while the unit was still occupied (exit confirmed); half deposit reserves it"
    },
    "visit_skipped": {
      "type": "boolean",
      "default": false
    },
    "site_visit_date": {
      "type": "string",
      "format": "date"
    },
    "site_visit_time": {
      "type": "string"
    },
    "site_visit_proposed_by": {
      "type": "string",
      "enum": [
        "",
        "tenant",
        "landlord"
      ],
      "default": ""
    },
    "site_visit_status": {
      "type": "string",
      "enum": [
        "",
        "Requested",
        "Proposed",
        "Confirmed",
        "Rescheduled",
        "Completed",
        "Cancelled",
        "No Show"
      ],
      "default": ""
    },
    "site_visit_notes": {
      "type": "string"
    },
    "agreement_url": {
      "type": "string"
    },
    "agreement_executed_url": {
      "type": "string"
    },
    "agreement_status": {
      "type": "string",
      "enum": [
        "",
        "Issued",
        "Executed",
        "Rejected"
      ],
      "default": ""
    },
    "next_of_kin_id": {
      "type": "string"
    },
    "payment_amount": {
      "type": "number",
      "default": 0
    },
    "payment_due_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_instructions": {
      "type": "string"
    },
    "payment_proof_url": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "mpesa_checkout_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "",
        "Requested",
        "Proof Submitted",
        "Verified",
        "Rejected"
      ],
      "default": ""
    },
    "payment_received_amount": {
      "type": "number"
    },
    "payment_approved_amount": {
      "type": "number"
    },
    "payment_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_receipt_number": {
      "type": "string"
    },
    "inspection_id": {
      "type": "string"
    },
    "inspection_approval_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ]
    },
    "tenancy_id": {
      "type": "string"
    },
    "landlord_approved": {
      "type": "boolean",
      "default": false
    },
    "completion_token": {
      "type": "string"
    },
    "completion_started_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "applicant_name",
    "unit_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}