{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "admin",
        "landowner",
        "client"
      ],
      "description": "Top-level account type: admin (platform), landowner (property provider), or client (end user)"
    },
    "operational_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "landlord",
          "vendor",
          "lessor",
          "tenant",
          "purchaser",
          "lessee"
        ]
      },
      "description": "Operational roles this user can act as. Landowners: landlord/vendor/lessor. Clients: tenant/purchaser/lessee."
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Clients start pending until a landowner approves their application; landowners and admins are approved immediately"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}