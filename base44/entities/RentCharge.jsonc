{
  "name": "RentCharge",
  "type": "object",
  "properties": {
    "tenancy_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "billing_period": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "outstanding": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Unpaid",
        "Partial",
        "Paid",
        "Overdue",
        "Void"
      ],
      "default": "Unpaid"
    },
    "notes": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenancy_id",
    "billing_period",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "landowner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}