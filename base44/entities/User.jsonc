{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "admin",
        "landowner",
        "client"
      ],
      "description": "Top-level account type: admin (platform), landowner (property provider), or client (tenant)"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Clients start pending until a landowner approves their application; landowners and admins are approved immediately"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "description": "State, county, or region"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "profile_image": {
      "type": "string",
      "description": "Private file reference or existing profile photo URL"
    },
    "display_name": {
      "type": "string",
      "maxLength": 254
    },
    "section_alert_seen": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "alert_item_seen": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "role"
  ]
}