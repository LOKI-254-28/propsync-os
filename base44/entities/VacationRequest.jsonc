{
  "name": "VacationRequest",
  "type": "object",
  "properties": {
    "request_reference": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Vacation Notice",
        "Termination Notice",
        "Early Termination Request"
      ],
      "default": "Vacation Notice"
    },
    "tenant_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "tenancy_reference": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "date_submitted": {
      "type": "string",
      "format": "date"
    },
    "proposed_vacation_date": {
      "type": "string",
      "format": "date"
    },
    "notice_period_days": {
      "type": "number",
      "default": 30
    },
    "calculated_notice_expiry": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "landlord_response": {
      "type": "string"
    },
    "final_inspection_id": {
      "type": "string"
    },
    "outstanding_rent": {
      "type": "number",
      "default": 0
    },
    "outstanding_charges": {
      "type": "number",
      "default": 0
    },
    "deposit_treatment": {
      "type": "string"
    },
    "final_meter_reading": {
      "type": "string"
    },
    "handover_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Submitted",
        "Acknowledged",
        "Clarification Requested",
        "Approved",
        "Final Inspection Scheduled",
        "Completed",
        "Rejected"
      ],
      "default": "Submitted"
    },
    "owner_user_id": {
      "type": "string"
    },
    "initiated_by": {
      "type": "string",
      "enum": [
        "tenant",
        "landlord"
      ]
    },
    "issued_by_user_id": {
      "type": "string"
    },
    "tenant_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "tenant_response": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachment_url": {
      "type": "string"
    },
    "creation_token": {
      "type": "string"
    },
    "operation_token": {
      "type": "string"
    },
    "operation_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "pending_event": {
      "type": "object"
    },
    "completion_state": {
      "type": "string",
      "enum": [
        "In Progress",
        "Done"
      ]
    },
    "actual_exit_date": {
      "type": "string",
      "format": "date"
    },
    "early_exit_agreed": {
      "type": "boolean"
    },
    "completed_by": {
      "type": "string"
    },
    "scheduled_release_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_release_status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "Awaiting Handover",
        "Completed",
        "Cancelled"
      ]
    },
    "scheduled_release_token": {
      "type": "string"
    },
    "scheduled_by_user_id": {
      "type": "string"
    },
    "handover_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "handover_confirmed_by": {
      "type": "string"
    }
  },
  "required": [
    "tenancy_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}