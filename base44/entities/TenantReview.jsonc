{
  "name": "TenantReview",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "landlord_name": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "maxLength": 2000
    },
    "visibility": {
      "type": "string",
      "enum": [
        "Public",
        "Hidden"
      ],
      "default": "Public"
    },
    "removed": {
      "type": "boolean",
      "default": false
    },
    "removed_by": {
      "type": "string"
    },
    "removed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "owner_user_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.removed": {
                "$ne": true
              }
            },
            {
              "data.visibility": {
                "$in": [
                  "Public",
                  null
                ]
              }
            }
          ]
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}