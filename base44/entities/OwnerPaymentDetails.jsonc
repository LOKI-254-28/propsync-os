{
  "name": "OwnerPaymentDetails",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "payee_name": {
      "type": "string",
      "maxLength": 120
    },
    "mpesa_paybill": {
      "type": "string",
      "maxLength": 10
    },
    "bank_name": {
      "type": "string",
      "maxLength": 120
    },
    "bank_account_name": {
      "type": "string",
      "maxLength": 120
    },
    "bank_account_number": {
      "type": "string",
      "maxLength": 40
    },
    "bank_branch": {
      "type": "string",
      "maxLength": 120
    },
    "payment_instructions": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}