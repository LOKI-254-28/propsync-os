{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "admin",
        "landowner",
        "client",
        "guest"
      ],
      "description": "Top-level account type: admin (platform), landowner (property provider), client (end user), or guest (basic browsing account)"
    },
    "operational_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "landlord",
          "tenant"
        ]
      },
      "description": "Operational roles this user can act as. Landowners: landlord. Clients: tenant. (Rentals-only platform.)"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Clients start pending until a landowner approves their application; landowners and admins are approved immediately; guests are approved immediately"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "description": "State, county, or region"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "profile_image": {
      "type": "string",
      "description": "Profile photo URL"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}