{
  "name": "Inspection",
  "type": "object",
  "properties": {
    "inspection_reference": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Pre-tenancy",
        "Move-in",
        "Routine",
        "Maintenance",
        "Move-out",
        "Final"
      ],
      "default": "Routine"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "conducted_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "Scheduled",
        "Completed",
        "Cancelled",
        "Rescheduled"
      ],
      "default": "Requested"
    },
    "condition_rating": {
      "type": "string",
      "enum": [
        "Excellent",
        "Good",
        "Fair",
        "Poor"
      ],
      "default": "Good"
    },
    "defects": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_maintenance_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "report_uri": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "enum": [
              "Excellent",
              "Good",
              "Fair",
              "Poor"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "area",
          "condition"
        ]
      }
    },
    "tenant_approval_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ]
    },
    "tenant_comment": {
      "type": "string"
    },
    "supporting_documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responded_by": {
      "type": "string"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_token": {
      "type": "string"
    },
    "submission_token": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "unit_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "data.application_id": {
                "$in": [
                  "",
                  null
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}