{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Lease Agreement",
        "ID/Passport",
        "KRA PIN",
        "Proof of Income",
        "Employer Letter",
        "Receipt",
        "Inspection Report",
        "Insurance/Compliance Certificate",
        "Title Deed",
        "Sale Agreement",
        "Other"
      ],
      "default": "Other"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size": {
      "type": "number",
      "default": 0
    },
    "property_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "maintenance_id": {
      "type": "string"
    },
    "inspection_id": {
      "type": "string"
    },
    "notice_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_by_role": {
      "type": "string",
      "enum": [
        "staff",
        "tenant"
      ],
      "default": "staff"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "tenant_visible",
        "staff_only"
      ],
      "default": "staff_only"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "review_note": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "date_uploaded": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_user_id": "{{user.id}}"
            },
            {
              "data.visibility": "tenant_visible"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "landowner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}