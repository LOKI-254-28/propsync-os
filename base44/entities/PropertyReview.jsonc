{
  "name": "PropertyReview",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "rating"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}