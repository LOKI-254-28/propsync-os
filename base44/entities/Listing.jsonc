{
  "name": "Listing",
  "type": "object",
  "properties": {
    "listing_reference": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "Rent",
        "Sale",
        "Lease"
      ],
      "default": "Rent"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Published",
        "Reserved",
        "Under Application",
        "Rented",
        "Leased",
        "Sold",
        "Withdrawn",
        "Expired",
        "Archived",
        "Active",
        "Pending",
        "Closed"
      ],
      "default": "Draft"
    },
    "date_listed": {
      "type": "string",
      "format": "date"
    },
    "date_closed": {
      "type": "string",
      "format": "date"
    },
    "owner_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "listing_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.status": "Published"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "landowner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    }
  }
}