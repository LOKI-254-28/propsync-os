{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "tenancy_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "sender_user_id": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "tenant",
        "landlord"
      ]
    },
    "text": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tenancy_id",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}