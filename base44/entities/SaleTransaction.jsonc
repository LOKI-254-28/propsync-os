{
  "name": "SaleTransaction",
  "type": "object",
  "properties": {
    "transaction_reference": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "seller_user_id": {
      "type": "string"
    },
    "buyer_user_id": {
      "type": "string"
    },
    "buyer_tenant_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "sale_price": {
      "type": "number",
      "default": 0
    },
    "deposit_paid": {
      "type": "number",
      "default": 0
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Under Contract",
        "Completed",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "agreement_document_url": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "sale_price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.buyer_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "landowner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}