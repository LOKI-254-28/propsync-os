{
  "name": "Payment",
  "type": "object",
  "properties": {
    "payment_reference": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "enum": [
        "M-Pesa",
        "Bank Transfer",
        "Card",
        "Cash",
        "Manual Adjustment",
        "Other"
      ],
      "default": "M-Pesa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Successful",
        "Failed",
        "Reversed",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "charge_id": {
            "type": "string"
          },
          "billing_period": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "receipt_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "amount",
    "payment_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}