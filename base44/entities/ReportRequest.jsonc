{
  "name": "ReportRequest",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "Portfolio",
        "Property"
      ]
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "In Progress",
        "Completed",
        "Declined"
      ],
      "default": "Requested"
    },
    "admin_note": {
      "type": "string",
      "maxLength": 2000
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object"
        },
        "monthly": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "occupancy": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "required": [
    "owner_user_id",
    "scope",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}